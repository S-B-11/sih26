# ORCA Backend Environment Variables
# Copy this file to .env and fill in your actual values

PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/orca_db
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/orca_db

# CORS — allow the Vite frontend dev server
FRONTEND_URL=http://localhost:3000

# ISRO / INCOIS API Keys (when integrating live data)
INCOIS_API_KEY=your_incois_api_key_here
ISRO_MOSDAC_API_KEY=your_mosdac_api_key_here
OCEANSAT3_TOKEN=your_token_here

# JWT Secret (for future auth)
JWT_SECRET=orca_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
