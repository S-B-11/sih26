# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
frontend/dist/
frontend/.next/
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
build/

# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
backend/.env
.agents/

# Local tool config — .mcp.json can contain live API keys, never commit it
.claude/
.mcp.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary files
scratch/
.system_generated/

# Warmed upstream responses (generated by backend/warm_cache.py).
# Regenerate before a demo rather than committing stale sea state.
backend/data_sources/cache/
